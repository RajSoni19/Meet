# ---------------------------------------------------------------------------
# Supabase  (required)
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# TURN server (REQUIRED for calls between users on different networks)
#
# WebRTC only connects directly when both users can reach each other. Testing
# locally with two tabs works without TURN, but once deployed, real users are
# behind home/office/mobile NATs and firewalls — without a TURN relay their
# media never connects (the call stays "connecting" / no video appears).
#
# Get FREE TURN credentials (50 GB/month) in ~2 minutes:
#   1. Sign up at https://dashboard.metered.ca/
#   2. Open "TURN Server" -> it shows your URLs + username + password.
#   3. Paste them below. NEXT_PUBLIC_TURN_URL accepts a comma-separated list.
#
# IMPORTANT: NEXT_PUBLIC_* vars are inlined at BUILD time. After setting these
# in Vercel (Project Settings -> Environment Variables) you MUST redeploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURN_URL=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turn:standard.relay.metered.ca:443?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
