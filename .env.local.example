# ---------------------------------------------------------------------------
# Supabase  (required)
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# TURN server (optional but recommended for production)
# WebRTC uses STUN by default (works on most networks). For users behind
# strict/symmetric NATs or corporate firewalls you need a TURN relay.
# Get free credentials from https://www.metered.ca/tools/openrelay/ or
# self-host coturn.  Leave blank to use STUN only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
